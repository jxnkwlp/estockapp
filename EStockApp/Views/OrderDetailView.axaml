<UserControl
    x:Class="EStockApp.Views.OrderDetailView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ct="clr-namespace:EStockApp.Controls;assembly=EStockApp"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:EStockApp.ViewModels"
    Width="860"
    Height="420"
    d:DesignHeight="420"
    d:DesignWidth="860"
    x:DataType="vm:OrderDetailViewModel"
    mc:Ignorable="d">
    <Design.DataContext>
        <vm:OrderDetailViewModel />
    </Design.DataContext>

    <Grid Margin="10">
        <DataGrid
            BorderThickness="1"
            CanUserResizeColumns="True"
            IsReadOnly="True"
            ItemsSource="{Binding Items, Mode=OneWay}"
            SelectionMode="Single">
            <DataGrid.Columns>
                <ct:DataGridTextSelectableColumn
                    Width="120"
                    Binding="{Binding BrandName}"
                    Header="品牌"
                    SortMemberPath="BrandName" />

                <ct:DataGridTextSelectableColumn
                    Width="110"
                    Binding="{Binding ProductCode}"
                    Header="编号"
                    SortMemberPath="ProductCode" />

                <ct:DataGridTextSelectableColumn
                    Width="*"
                    MinWidth="160"
                    Binding="{Binding ProductName}"
                    Header="名称"
                    SortMemberPath="ProductName" />

                <ct:DataGridTextSelectableColumn
                    Width="120"
                    Binding="{Binding ProductModel}"
                    Header="型号"
                    SortMemberPath="ProductModel" />

                <ct:DataGridTextSelectableColumn
                    Width="70"
                    Binding="{Binding TotalCount}"
                    Header="数量"
                    SortMemberPath="TotalCount" />

                <ct:DataGridTextSelectableColumn
                    Width="80"
                    Binding="{Binding UnitPrice}"
                    Header="单价"
                    SortMemberPath="UnitPrice" />

                <ct:DataGridTextSelectableColumn
                    Width="80"
                    Binding="{Binding TotalPrice}"
                    Header="价格"
                    SortMemberPath="TotalPrice" />

                <ct:DataGridTextSelectableColumn
                    Width="80"
                    Binding="{Binding Discount}"
                    Header="优惠"
                    SortMemberPath="Discount" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
