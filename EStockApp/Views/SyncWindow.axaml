<Window
    x:Class="EStockApp.SyncWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ct="clr-namespace:EStockApp.Controls;assembly=EStockApp"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:EStockApp.ViewModels"
    Title="同步"
    Width="860"
    Height="480"
    MinWidth="860"
    MinHeight="480"
    x:CompileBindings="True"
    x:DataType="vm:SyncWindowViewModel"
    CanResize="True"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Design.DataContext>
        <vm:SyncWindowViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="auto,*,auto">
        <Grid Margin="10">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock VerticalAlignment="Center">开始日期</TextBlock>
                <DatePicker
                    IsEnabled="{Binding !IsBusy}"
                    MaxYear="{Binding MaxYear}"
                    MonthFormat="MM"
                    SelectedDate="{Binding StartDate, Mode=TwoWay}" />
                <!--<CheckBox
                    VerticalAlignment="Center"
                    Content="从订单同步"
                    IsChecked="{Binding LoadFromOrder, Mode=TwoWay}"
                    IsEnabled="{Binding !IsBusy}" />-->
                <Button
                    Command="{Binding StartCommand}"
                    IsEnabled="{Binding !IsBusy}"
                    Theme="{DynamicResource SolidButton}">开始同步</Button>
            </StackPanel>
        </Grid>
        <DataGrid
            x:Name="SyncRecordsGrid"
            Grid.Row="1"
            BorderThickness="1"
            CanUserResizeColumns="True"
            IsReadOnly="True"
            ItemsSource="{Binding Records, Mode=OneWay}"
            SelectionMode="Single">
            <DataGrid.Columns>
                <ct:DataGridTextSelectableColumn
                    Width="70"
                    Binding="{Binding ActionText}"
                    Header="动作"
                    SortMemberPath="ActionText" />

                <ct:DataGridTextSelectableColumn
                    Width="130"
                    Binding="{Binding OrderNo}"
                    Header="订单号"
                    SortMemberPath="OrderNo" />

                <ct:DataGridTextSelectableColumn
                    Width="110"
                    Binding="{Binding ProductCode}"
                    Header="产品编号"
                    SortMemberPath="ProductCode" />

                <ct:DataGridTextSelectableColumn
                    Width="*"
                    MinWidth="160"
                    Binding="{Binding ProductName}"
                    Header="产品名称"
                    SortMemberPath="ProductName" />

                <ct:DataGridTextSelectableColumn
                    Width="80"
                    Binding="{Binding Quantity}"
                    Header="数量"
                    SortMemberPath="Quantity"
                    TextAlignment="Right" />

                <ct:DataGridTextSelectableColumn
                    Width="170"
                    MinWidth="170"
                    Binding="{Binding SyncedAt, Mode=OneWay, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                    Header="时间"
                    SortMemberPath="SyncedAt" />
            </DataGrid.Columns>
        </DataGrid>
        <Grid Grid.Row="2" Margin="10">
            <TextBlock
                VerticalAlignment="Center"
                Text="{Binding StatusText}" />
        </Grid>
    </Grid>
</Window>
