<Window
    x:Class="EStockApp.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:EStockApp.Behaviors;assembly=EStockApp"
    xmlns:ct="clr-namespace:EStockApp.Controls;assembly=EStockApp"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="clr-namespace:Avalonia.Xaml.Interactivity;assembly=Xaml.Behaviors.Interactivity"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:EStockApp.ViewModels"
    Title="电子器件库存记录管理"
    Width="1200"
    Height="600"
    MinWidth="800"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:CompileBindings="True"
    x:DataType="vm:MainWindowViewModel"
    Icon="/Assets/logo.png"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <i:Interaction.Behaviors>
        <behaviors:FocusControlOnKeyBehavior TargetName="FilterTextBox" />
    </i:Interaction.Behaviors>

    <Window.KeyBindings>
        <KeyBinding Command="{Binding SearchCommand}" Gesture="F5" />
        <KeyBinding Command="{Binding ClearFiltersCommand}" Gesture="Escape" />
    </Window.KeyBindings>

    <Grid RowDefinitions="auto,*,auto">

        <Grid Margin="10" ColumnDefinitions="*,auto">
            <Grid>
                <StackPanel
                    IsEnabled="{Binding !IsBusy}"
                    Orientation="Horizontal"
                    Spacing="10">
                    <ComboBox
                        x:Name="CategoryComboBox"
                        Width="150"
                        AutoScrollToSelectedItem="True"
                        IsTextSearchEnabled="False"
                        ItemsSource="{Binding CategoryList}"
                        MaxDropDownHeight="350"
                        SelectedItem="{Binding SelectCategory, Mode=TwoWay}">
                        <i:Interaction.Behaviors>
                            <behaviors:CategoryLetterNavigationBehavior />
                        </i:Interaction.Behaviors>
                    </ComboBox>
                    <TextBox
                        x:Name="FilterTextBox"
                        MinWidth="200"
                        MaxWidth="500"
                        Margin="0"
                        Classes="clearButton"
                        Text="{Binding ListFilter, Mode=TwoWay}"
                        Watermark="多个关键词用空格分隔">
                        <TextBox.KeyBindings>
                            <KeyBinding Command="{Binding SearchCommand}" Gesture="Enter" />
                        </TextBox.KeyBindings>
                    </TextBox>
                    <Button
                        Command="{Binding SearchCommand}"
                        Content="搜索"
                        Theme="{DynamicResource SolidButton}" />
                    <Button
                        Classes="Tertiary"
                        Command="{Binding ShowOrderListCommand}"
                        Content="订单列表"
                        Theme="{DynamicResource SolidButton}" />
                </StackPanel>
            </Grid>
            <Grid Grid.Column="1">
                <StackPanel
                    IsEnabled="{Binding !IsBusy}"
                    Orientation="Horizontal"
                    Spacing="4">
                    <Button
                        Classes="Tertiary"
                        Command="{Binding ShowSyncViewCommand}"
                        Content="同步"
                        Theme="{DynamicResource SolidButton}" />
                    <Button
                        Classes="Secondary"
                        Command="{Binding BackupDbCommand}"
                        Content="备份"
                        Theme="{DynamicResource SolidButton}" />
                    <Button
                        Classes="Success"
                        Command="{Binding AddCommand}"
                        Content="新增"
                        Theme="{DynamicResource SolidButton}" />

                </StackPanel>
            </Grid>
        </Grid>

        <Grid Grid.Row="1">
            <DataGrid
                x:Name="myDataGrid"
                BorderThickness="1"
                CanUserResizeColumns="True"
                IsReadOnly="True"
                ItemsSource="{Binding Items, Mode=OneWay}"
                SelectionMode="Single">
                <i:Interaction.Behaviors>
                    <behaviors:DataGridUxBehavior />
                </i:Interaction.Behaviors>
                <DataGrid.Columns>

                    <ct:DataGridTextSelectableColumn
                        Width="150"
                        Binding="{Binding Category}"
                        Header="类目"
                        SortMemberPath="Category"
                        Tag="Category" />

                    <ct:DataGridTextSelectableColumn
                        Width="*"
                        MinWidth="200"
                        Binding="{Binding ProductName}"
                        Header="名称"
                        SortMemberPath="ProductName"
                        Tag="ProductName" />

                    <ct:DataGridTextSelectableColumn
                        Width="150"
                        Binding="{Binding ProductModel}"
                        Header="型号"
                        SortMemberPath="ProductModel"
                        Tag="ProductModel" />

                    <ct:DataGridTextSelectableColumn
                        Width="150"
                        Binding="{Binding Pack}"
                        Header="封装"
                        SortMemberPath="Pack"
                        Tag="Pack" />

                    <ct:DataGridTextSelectableColumn
                        Width="150"
                        Binding="{Binding BrandName}"
                        Header="品牌"
                        SortMemberPath="BrandName"
                        Tag="BrandName" />

                    <ct:DataGridTextSelectableColumn
                        Width="120"
                        Binding="{Binding ProductCode}"
                        Header="编号"
                        SortMemberPath="ProductCode"
                        Tag="ProductCode" />

                    <DataGridTemplateColumn
                        Width="100"
                        Header="数量"
                        SortMemberPath="StockCount"
                        Tag="StockCount">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <TextBlock Text="{Binding StockCount}" />
                                    <TextBlock Text="/" />
                                    <TextBlock Text="{Binding TotalCount}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Width="130" Header="操作" Tag="Actions">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel
                                    HorizontalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="2">
                                    <Button
                                        Classes="Small Secondary"
                                        Command="{Binding #myDataGrid.((vm:MainWindowViewModel)DataContext).UpdateStockCommand}"
                                        CommandParameter="{Binding Id}">
                                        库存
                                    </Button>
                                    <SplitButton
                                        Classes="Small Secondary"
                                        Command="{Binding #myDataGrid.((vm:MainWindowViewModel)DataContext).EditCommand}"
                                        CommandParameter="{Binding Id}"
                                        Content="编辑">
                                        <SplitButton.Flyout>
                                            <MenuFlyout Placement="Bottom">
                                                <MenuItem
                                                    Command="{Binding #myDataGrid.((vm:MainWindowViewModel)DataContext).ShowOrderNoCommand}"
                                                    CommandParameter="{Binding Id}"
                                                    Header="相关订单" />
                                                <Separator />
                                                <MenuItem
                                                    Command="{Binding #myDataGrid.((vm:MainWindowViewModel)DataContext).OpenUrlCommand}"
                                                    CommandParameter="{Binding Id}"
                                                    Header="打开详细页" />
                                                <Separator />
                                                <MenuItem
                                                    Command="{Binding #myDataGrid.((vm:MainWindowViewModel)DataContext).DeleteCommand}"
                                                    CommandParameter="{Binding Id}"
                                                    Header="删除" />
                                            </MenuFlyout>
                                        </SplitButton.Flyout>
                                    </SplitButton>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <Grid Grid.Row="2" Margin="10,4">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="{Binding TotalCategoryCount, StringFormat='合计种类：{0}'}" />
                <TextBlock Text="{Binding TotalCount, StringFormat='合计数量：{0}'}" />
                <TextBlock Text="{Binding TotalStockCount, StringFormat='剩余库存：{0}'}" />
            </StackPanel>
        </Grid>

    </Grid>

</Window>
